# ============================================================
# MINEx — Environment Template
# Copy this file to .env and fill in your actual credentials.
# Also copy the NEXT_PUBLIC_* and CLERK_* vars to apps/web/.env.local
# ============================================================

DATABASE_URL=postgres://user:password@host:port/defaultdb?sslmode=require
JWT_SECRET_KEY=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Demo Bootstrap (local dev only) ─────────────────────────
# Set DEMO_BOOTSTRAP_ENABLED=true only in local development.
# NEVER set true in production — use Clerk identity instead.
DEMO_BOOTSTRAP_ENABLED=false
DEMO_ADMIN_PASSWORD=change-this-admin-password
DEMO_USER_PASSWORD=change-this-user-password

# ── Clerk Auth (Next.js frontend) ───────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ── AI / Groq ────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-20b

# ── Frontend API URL ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors · OpenFreeMap

# ── ML / Backend paths & Storage ─────────────────────────────
ML_ARTIFACTS_DIR=apps/ml/artifacts
DATA_DIR=docs/SIH26009_DATA
TRAINING_MODE=modal
GDRIVE_FOLDER_ID=1XykuJ8El-yQ_27FrdCzL7VHraoyGrBKy
GDRIVE_FOLDER_URL=https://drive.google.com/drive/folders/1XykuJ8El-yQ_27FrdCzL7VHraoyGrBKy?usp=drive_link
# Optional service account credentials (JSON string or path to .json file) for direct Google Drive API access:
GOOGLE_SERVICE_ACCOUNT_JSON=
LOG_LEVEL=INFO
ENVIRONMENT=development

# ── Modal.com Serverless Cloud Training ───────────────────────
# Get these credentials from https://modal.com/settings/tokens
# MODAL_TOKEN_ID=ak-...
# ── Redis / Tiered Caching (Upstash Serverless or Local Redis) ──
# rediss:// indicates a TLS-secured connection (required by Upstash).
# If REDIS_URL is omitted or unset, the system gracefully falls back to L1 in-memory caching.
REDIS_ENABLED=true
REDIS_URL=rediss://default:<password>@<endpoint>:6379
REDIS_TTL_DEFAULT=60
REDIS_L1_TTL_DEFAULT=10
REDIS_L1_MAX_ENTRIES=1000
REDIS_MAX_CONNECTIONS=10
REDIS_CONNECT_TIMEOUT=1.0
REDIS_SOCKET_TIMEOUT=1.5
REDIS_CIRCUIT_BREAKER_SECONDS=30
REDIS_COMPRESSION_THRESHOLD_BYTES=25600
REDIS_STALE_MAX_SECONDS=300
CACHE_SCHEMA_VERSION=1
CACHE_ENABLE_STALE_WHILE_REVALIDATE=true

